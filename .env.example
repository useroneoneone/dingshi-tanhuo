# Docker Compose reads this file after it is renamed to .env.
# Initial bootstrap only. Existing administrators are never reset on restart.
ADMIN_USERNAME=admin
# At least 12 characters. Leave empty to generate a password in the startup log.
ADMIN_PASSWORD=
# Match the tag built locally, loaded from an archive or pulled from a registry.
TANHUO_IMAGE=dingshi-tanhuo:1.0.0
HOST_PORT=3000
# Remote access: use an HTTPS reverse proxy or an SSH tunnel.
HOST_BIND=127.0.0.1
# Local builds only. Optional official mirror:
# public.ecr.aws/docker/library/node:24-bookworm-slim
NODE_IMAGE=node:24-bookworm-slim
# Set true when accessed exclusively over HTTPS.
SECURE_COOKIE=false
# Enable only behind your trusted reverse proxy, with the app port not public.
TRUST_PROXY=false
# Explicit opt-in for LAN, localhost or private Docker-network upstreams.
ALLOW_PRIVATE_ENDPOINTS=false
